<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- TIMER RECUPERO -->
    <TextView
        android:id="@+id/txtTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Recupero: 60s (Tocca per cambiare)"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RECYCLERVIEW DEGLI ESERCIZI -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewEsercizi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTimer"
        app:layout_constraintBottom_toTopOf="@id/btnAggiungiEsercizio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTONE AGGIUNGI ESERCIZIO -->
    <Button
        android:id="@+id/btnAggiungiEsercizio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+ Aggiungi Esercizio"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnSalvaAllenamento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTONE SALVA ALLENAMENTO -->
    <Button
        android:id="@+id/btnSalvaAllenamento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="💾 Salva Allenamento"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>